package layout

// BaseProps configures the page shell. Active names the nav link to
// highlight, and Maps loads Leaflet for pages that draw a map.
type BaseProps struct {
	Title       string
	Description string
	Active      string
	Maps        bool
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en-GB">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ props.Title } · Wild Sightings</title>
			if props.Description != "" {
				<meta name="description" content={ props.Description }/>
			}
			<meta name="theme-color" content="#2b1a10"/>
			<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><path d='M11 3l5 5 5-5' fill='none' stroke='%23d9a93b' stroke-width='2' stroke-linecap='round'/><rect x='2' y='8' width='28' height='21' rx='4' fill='%236b3f22'/><rect x='5' y='11' width='17' height='15' rx='4' fill='%23f2e3c6'/><circle cx='26' cy='14' r='2' fill='%23d9a93b'/><circle cx='26' cy='21' r='2' fill='%23d9a93b'/><circle cx='13.5' cy='20.5' r='3' fill='%23e07b39'/><circle cx='9.5' cy='16' r='1.4' fill='%23e07b39'/><circle cx='12.5' cy='14.5' r='1.4' fill='%23e07b39'/><circle cx='15.5' cy='14.5' r='1.4' fill='%23e07b39'/><circle cx='18' cy='16' r='1.4' fill='%23e07b39'/></svg>"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=Righteous&family=VT323&display=swap"/>
			<link rel="stylesheet" href="/assets/css/app.css"/>
			<script>
				try {
					if (sessionStorage.getItem('tv-on')) document.documentElement.classList.add('tv-warm');
				} catch (e) {}
			</script>
			if props.Maps {
				<link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css"/>
				<script src="/assets/vendor/leaflet/leaflet.js" defer></script>
			}
		</head>
		<body class="room">
			<a class="skip-link" href="#main">Skip to content</a>
			<div class={ tvClass(props.Active) }>
				<div class="tv__cabinet">
					<div class="tv__bezel">
						<div class="tv__screen" data-screen tabindex="-1">
							<div class="tv__picture">
								<header class="site-header">
									<div class="site-header__inner">
										<a class="brand" href="/">
											<span class="brand__mark" aria-hidden="true">
												<svg viewBox="0 0 32 32" fill="none">
													<path d="M11 3l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
													<rect x="2" y="8" width="28" height="21" rx="4" stroke="currentColor" stroke-width="2"></rect>
													<circle cx="13.5" cy="20.5" r="3" fill="#e07b39"></circle>
													<circle cx="9.5" cy="16" r="1.4" fill="#e07b39"></circle>
													<circle cx="12.5" cy="14.5" r="1.4" fill="#e07b39"></circle>
													<circle cx="15.5" cy="14.5" r="1.4" fill="#e07b39"></circle>
													<circle cx="18" cy="16" r="1.4" fill="#e07b39"></circle>
													<circle cx="26" cy="14" r="1.6" fill="currentColor"></circle>
													<circle cx="26" cy="21" r="1.6" fill="currentColor"></circle>
												</svg>
											</span>
											<span class="brand__name">Wild Sightings</span>
										</a>
										<nav class="site-nav" aria-label="Main">
											for i, c := range channels {
												@navLink(i, c, props.Active)
											}
										</nav>
									</div>
								</header>
								<main id="main" class="container">
									{ children... }
								</main>
								<footer class="site-footer">
									<p>
										Occurrence data from <a href="https://www.gbif.org" rel="noopener">GBIF</a>,
										weather from <a href="https://open-meteo.com" rel="noopener">Open-Meteo</a>,
										map tiles © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors.
										Built with Go, sqlc and templ at GopherCon Africa 2026.
									</p>
								</footer>
							</div>
						</div>
						<div class="tv__glass" aria-hidden="true"></div>
						<div class="tv__static" aria-hidden="true"></div>
						<p class="tv__osd" aria-hidden="true">{ channelName(props.Active) }</p>
					</div>
					<div class="tv__panel">
						<p class="tv__plate" aria-hidden="true">Wildvision</p>
						<div class="tv__knobs">
							<a class="knob knob--channel" href={ templ.SafeURL(tune(props.Active, 1).Href) } data-channel aria-label={ "Next channel: " + tune(props.Active, 1).Label }>
								<span class="knob__cap" aria-hidden="true"></span>
								<span class="knob__label" aria-hidden="true">Channel</span>
							</a>
							<a class="knob knob--back" href={ templ.SafeURL(tune(props.Active, -1).Href) } data-channel aria-label={ "Previous channel: " + tune(props.Active, -1).Label }>
								<span class="knob__cap" aria-hidden="true"></span>
								<span class="knob__label" aria-hidden="true">Back</span>
							</a>
						</div>
						<div class="tv__speaker" aria-hidden="true"></div>
						<span class="tv__power" aria-hidden="true"></span>
					</div>
				</div>
				<div class="tv__legs" aria-hidden="true"><span></span><span></span></div>
			</div>
			<script src="/assets/js/app.js" defer></script>
		</body>
	</html>
}

templ navLink(i int, c Channel, active string) {
	<a
		href={ templ.SafeURL(c.Href) }
		data-channel
		if c.Label == active {
			aria-current="page"
		}
	><span class="site-nav__ch" aria-hidden="true">{ i + 1 }</span>{ c.Label }</a>
}
