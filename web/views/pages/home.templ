package pages

import (
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Home(sightings []sighting.Sighting) {
	@layout.Base(layout.BaseProps{
		Title:       "Sightings",
		Description: "Wildlife sightings from around the world, with the weather at the time.",
		Active:      "Sightings",
	}) {
		<section class="hero">
			<div class="hero__text">
				<div class="colour-bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
				<p class="eyebrow">Now showing · Live from the wild</p>
				<h1>Every animal, everywhere it's been seen.</h1>
				<p class="lede">
					Lions in the Mara, humpbacks off Cape Town, penguins on the ice. Each sighting is a real record,
					with the weather in the hour it happened.
				</p>
				<div class="hero__actions">
					<a class="button" href="/map">Explore the map</a>
					<a class="button button--ghost" href="/stats">See the numbers</a>
				</div>
			</div>
			<div class="globe">
				<canvas class="globe__canvas" data-globe="/api/points" aria-hidden="true"></canvas>
				<p class="globe__hint" aria-hidden="true">Drag to spin · Click a point</p>
				@hologram()
			</div>
		</section>
		<section aria-labelledby="latest">
			<div class="section-head">
				<h2 id="latest">Latest sightings</h2>
				<a href="/gallery">Browse the gallery →</a>
			</div>
			if len(sightings) == 0 {
				<p class="empty">No sightings have been ingested yet. Run <code>go run . db seed</code> to fetch some.</p>
			} else {
				@components.SightingGrid(sightings)
			}
		</section>
	}
}

// hologram is the panel the globe projects above a sighting when its
// point is clicked. app.js fills it in and shows it.
templ hologram() {
	<div class="hologram" data-hologram role="dialog" aria-label="Sighting details" hidden>
		<div class="hologram__panel">
			<button class="hologram__close" type="button" aria-label="Close" data-hologram-close>×</button>
			<p class="hologram__group" data-holo="group"></p>
			<div class="hologram__head">
				<div class="hologram__photo" data-holo="photo"><img alt="" loading="lazy"/></div>
				<div>
					<h3 class="hologram__name" data-holo="name"></h3>
					<p class="hologram__sci" data-holo="scientific"></p>
				</div>
			</div>
			<dl class="hologram__facts">
				<div><dt>Where</dt><dd data-holo="place"></dd></div>
				<div><dt>Seen</dt><dd data-holo="date"></dd></div>
				<div data-holo-row="weather"><dt>Weather</dt><dd data-holo="weather"></dd></div>
				<div data-holo-row="status"><dt>Red List</dt><dd data-holo="status"></dd></div>
			</dl>
			<a class="hologram__link" data-holo="link" href="/">See the sighting →</a>
			<span class="hologram__depth" aria-hidden="true"></span>
		</div>
	</div>
}
