package components

import (
	"strconv"
	"workshop/internal/domain/sighting"
	"workshop/web/views/format"
)

// SightingGrid lays sightings out as cards.
templ SightingGrid(sightings []sighting.Sighting) {
	<ul class="sightings">
		for _, s := range sightings {
			<li>
				@SightingCard(s)
			</li>
		}
	</ul>
}

templ SightingCard(s sighting.Sighting) {
	<article class="card" data-tilt>
		<a class="card__link" href={ templ.SafeURL(format.SightingURL(s)) }>
			<!-- Photo -->
			<div class="card__photo">
				if photo := format.FirstPhoto(s); photo != "" {
					<img src={ photo } alt={ format.DisplayName(s.Species) } loading="lazy" decoding="async"/>
				} else {
					<span class="card__placeholder" aria-hidden="true">NO SIGNAL</span>
				}
				if n := format.PhotoCount(s); n > 1 {
					<span class="card__count">{ "+" + strconv.Itoa(n-1) }</span>
				}
				@WeatherChip(s.Weather)
			</div>
			<!-- Header -->
			<header class="card__header">
				<h2>{ format.DisplayName(s.Species) }</h2>
				if s.Species.ScientificName != "" {
					<p class="card__scientific">{ s.Species.CanonicalName }</p>
				}
			</header>
			<!-- Meta -->
			<dl class="card__meta">
				<dt>Seen</dt>
				<dd>{ format.Date(s.HappenedAt) }</dd>
				<dt>Where</dt>
				<dd>{ format.Flag(s.Location.CountryCode) } { format.Place(s.Location) }</dd>
				if s.IndividualCount != nil {
					<dt>Count</dt>
					<dd>{ format.Individuals(*s.IndividualCount) }</dd>
				}
			</dl>
			<footer class="card__footer">
				@ConservationBadge(s.Species.IUCNCategory)
				if s.Organism.Sex != "" {
					<span class="tag">{ s.Organism.Sex }</span>
				}
				if s.Organism.LifeStage != "" {
					<span class="tag">{ s.Organism.LifeStage }</span>
				}
			</footer>
		</a>
	</article>
}
